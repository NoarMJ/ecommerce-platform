generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client-reconciliation"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique
  description String   @default("")
  image       String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  primaryProducts Product[] @relation("PrimaryCategory")
  products        Product[] @relation("ExtraCategories")

  @@map("categories")
}

enum Role {
  customer
  admin
}

enum SellerStatus {
  pending
  approved
  rejected
  suspended
}

enum SellerAccountType {
  individual
  company
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  firstName      String   @db.VarChar(50)
  lastName       String   @db.VarChar(50)
  email          String   @unique
  passwordHash   String
  phoneNumber    String   @default("")
  role           Role     @default(customer)
  permissions    String[] @default([])
  isPrimaryAdmin Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart          Cart?
  orders        Order[]
  statusChanges OrderStatusHistory[]
  payments      Payment[]
  sellerProfile SellerProfile?       @relation("SellerOwner")
  sellerReviews SellerProfile[]      @relation("SellerReviewer")
  stockMovements InventoryMovement[]  @relation("InventoryMovementActor")
  fulfilmentChanges SellerFulfilmentHistory[] @relation("FulfilmentActor")

  @@map("users")
}

model SellerProfile {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @unique @db.Uuid
  accountType     SellerAccountType
  dateOfBirth     DateTime          @db.Date
  shopName        String            @db.VarChar(120)
  companyName     String?           @db.VarChar(150)
  county          String            @db.VarChar(100)
  town            String            @db.VarChar(100)
  description     String            @default("")
  status          SellerStatus      @default(pending)
  submittedAt     DateTime          @default(now())
  reviewedAt      DateTime?
  reviewedById    String?           @db.Uuid
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user       User  @relation("SellerOwner", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("SellerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  products   Product[]
  orderItems OrderItem[]
  stockMovements InventoryMovement[]
  fulfilments    SellerFulfilment[]

  @@index([status, submittedAt])
  @@index([reviewedById])
  @@map("seller_profiles")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique
  description String
  priceMinor  Int
  images      String[] @default([])
  stock       Int      @default(0)
  sku         String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String         @db.Uuid
  category   Category       @relation("PrimaryCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  sellerId   String?        @db.Uuid
  seller     SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  categories Category[] @relation("ExtraCategories")

  cartItems  CartItem[]
  orderItems OrderItem[]
  stockMovements InventoryMovement[]

  @@index([categoryId])
  @@index([sellerId])
  @@map("products")
}

model Cart {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @unique @db.Uuid
  guestTokenHash String?   @unique
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @db.Uuid
  productId String @db.Uuid
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@map("cart_items")
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum OrderPaymentStatus {
  pending
  paid
  failed
  refunded
}

enum PaymentMethod {
  cash_on_delivery
  mpesa
}

model Order {
  id             String @id @default(uuid()) @db.Uuid
  orderNumber    String @unique
  idempotencyKey String
  userId         String @db.Uuid

  shipFullName     String
  shipPhone        String
  shipAddressLine1 String
  shipAddressLine2 String?
  shipCity         String
  shipCounty       String
  shipPostalCode   String?

  customerNote  String?            @db.VarChar(500)
  paymentMethod PaymentMethod
  paymentStatus OrderPaymentStatus @default(pending)
  orderStatus   OrderStatus        @default(pending)

  subtotalMinor    Int
  shippingFeeMinor Int @default(0)
  totalMinor       Int

  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  stockMovements InventoryMovement[]
  fulfilments    SellerFulfilment[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id                       String  @id @default(uuid()) @db.Uuid
  orderId                  String  @db.Uuid
  productId                String  @db.Uuid
  name                     String
  sku                      String?
  image                    String?
  unitPriceMinor           Int
  quantity                 Int
  lineTotalMinor           Int
  sellerId                 String? @db.Uuid
  sellerShopNameAtPurchase String?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller  SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  position Int @default(0)

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @db.Uuid
  status      OrderStatus
  changedAt   DateTime    @default(now())
  changedById String?     @db.Uuid

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_status_history")
}

enum PaymentStatus {
  initiated
  succeeded
  failed
  cancelled
  needs_review
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @db.Uuid
  userId      String        @db.Uuid
  method      PaymentMethod @default(mpesa)
  phone       String
  amountMinor Int
  status      PaymentStatus @default(initiated)

  merchantRequestId            String?
  checkoutRequestId            String?   @unique
  mpesaReceiptNumber           String?   @unique
  reconciliationReceipt        String?   @unique
  reconciliationConversationId String?   @unique
  reconciliationStatus         String?
  reconciliationRequestedAt    DateTime?

  resultCode  Int?
  resultDesc  String?
  rawCallback Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order                Order                        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  receiptVerifications PaymentReceiptVerification[]

  @@index([orderId])
  @@map("payments")
}

model PaymentReceiptVerification {
  id             String   @id @default(uuid()) @db.Uuid
  paymentId      String   @db.Uuid
  receipt        String   @unique
  conversationId String?  @unique
  status         String   @default("pending")
  resultCode     Int?
  resultDesc     String?
  rawCallback    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_receipt_verifications")
}

// Every stock change is recorded here. Product.stock stays the live number;
// this table explains how it got there.
enum InventoryMovementType {
  initial         // stock entered when the product was created
  received        // seller received new units (+)
  removed         // returned to supplier, personal use, etc. (-)
  damaged         // damaged, lost or stolen (-)
  correction      // stock count correction (+ or -), incl. admin edits
  order           // customer order took stock (-)
  order_cancelled // cancelled order put stock back (+)
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @db.Uuid
  sellerId       String?               @db.Uuid
  type           InventoryMovementType
  quantityChange Int
  stockBefore    Int
  stockAfter     Int
  reason         String?               @db.VarChar(200)
  orderId        String?               @db.Uuid
  createdById    String?               @db.Uuid
  createdAt      DateTime              @default(now())

  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller    SellerProfile? @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?          @relation("InventoryMovementActor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([sellerId])
  @@index([orderId])
  @@map("inventory_movements")
}

// Each seller fulfils their own part of an order. Order.orderStatus is the
// overall status; it moves forward automatically as sellers progress.
enum FulfilmentStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

model SellerFulfilment {
  id             String           @id @default(uuid()) @db.Uuid
  orderId        String           @db.Uuid
  sellerId       String           @db.Uuid
  status         FulfilmentStatus @default(pending)
  courier        String?          @db.VarChar(80)
  trackingNumber String?          @db.VarChar(80)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  order   Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller  SellerProfile             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  history SellerFulfilmentHistory[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status])
  @@map("seller_fulfilments")
}

model SellerFulfilmentHistory {
  id           String           @id @default(uuid()) @db.Uuid
  fulfilmentId String           @db.Uuid
  status       FulfilmentStatus
  note         String?          @db.VarChar(200)
  changedById  String?          @db.Uuid
  changedAt    DateTime         @default(now())

  fulfilment SellerFulfilment @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)
  changedBy  User?            @relation("FulfilmentActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([fulfilmentId, changedAt])
  @@map("seller_fulfilment_history")
}
